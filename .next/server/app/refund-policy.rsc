hildren":"14 days"}]," of purchase for the unused portion of the subscription term, minus any platform setup or onboarding fees incurred."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Enterprise & custom plans:"}]," Refunds on enterprise contracts are governed by the individual service agreement (SLA/MSA) signed at the time of onboarding. Please contact your account manager at ",["$","a",null,{"href":"mailto:enterprise@novralab.com","children":"enterprise@novralab.com"}]," for assistance."]}]]}]]}],["$","section",null,{"className":"terms-section","children":[["$","h2",null,{"children":"3. One-Time Purchases & Setup Fees"}],["$","p",null,{"children":["One-time implementation fees, onboarding fees, and compliance platform set-up charges are",["$","strong",null,{"children":" non-refundable"}]," once work has commenced, unless:"]}],["$","ul",null,{"children":[["$","li",null,{"children":"NovraLab has materially failed to deliver the agreed scope of work."}],["$","li",null,{"children":"NovraLab cancels the engagement prior to commencement."}]]}],["$","p",null,{"children":"If a deliverable milestone is incomplete due to our fault, a partial refund proportional to the undelivered work will be issued."}]]}],["$","section",null,{"className":"terms-section","children":[["$","h2",null,{"children":"4. Add-On Modules"}],["$","p",null,{"children":"Optional add-on modules — including Regulatory Reporting Automation, Audit Preparation, AML/KYC Workflow Automation, and Custom Compliance Integration — are billed on a recurring basis as part of your subscription. Refunds for add-ons follow the same schedule as the base subscription tier to which they are attached."}],["$","p",null,{"children":"Add-ons that have been fully provisioned and activated are non-refundable after the applicable refund window has elapsed."}]]}],["$","section",null,{"className":"terms-section","children":[["$","h2",null,{"children":"5. Eligible Refund Grounds"}],["$","p",null,{"children":"We will issue a refund in the following circumstances, regardless of timing:"}],["$","ul",null,{"children":[["$","li",null,{"children":"A significant technical failure directly attributable to NovraLab that rendered the service unusable."}],["$","li",null,{"children":"Duplicate billing or an erroneous charge."}],["$","li",null,{"children":"A charge made after a confirmed cancellation."}],["$","li",null,{"children":"A billing error confirmed in writing by NovraLab or Paddle."}]]}]]}],["$","section",null,{"className":"terms-section","children":[["$","h2",null,{"children":"6. Non-Refundable Items"}],["$","p",null,{"children":"The following are explicitly non-refundable:"}],["$","ul",null,{"children":[["$","li",null,{"children":"Fees for services already rendered or substantially performed."}],["$","li",null,{"children":"Trial or promotional plan upgrades after the trial has ended."}],["$","li",null,{"children":"Partial months or billing periods already consumed."}],["$","li",null,{"children":"Currency conversion losses or third-party bank charges."}]]}]]}],["$","section",null,{"className":"terms-section","children":[["$","h2",null,{"children":"7. How to Request a Refund"}],["$","p",null,{"children":["To submit a refund request, email ",["$","a",null,{"href":"mailto:billing@novralab.com","children":"billing@novralab.com"}]," with the subject line ",["$","em",null,{"children":"\"Refund Request — [Your Order ID]\""}],". Please include:"]}],["$","ul",null,{"children":[["$","li",null,{"children":"Your registered email address and account name."}],["$","li",null,{"children":"Your Paddle order ID or invoice number."}],["$","li",null,{"children":"The reason for the refund request."}],["$","li",null,{"children":"Any supporting documentation (screenshots, error logs, etc.)."}]]}],["$","p",null,{"children":["Requests must be submitted within ",["$","strong",null,{"children":"30 days"}]," of the charge date. We aim to respond within ",["$","strong",null,{"children":"3 business days"}],". Once approved, refunds are processed by Paddle and typically appear on your statement within ",["$","strong",null,{"children":"5–10 business days"}],"."]}]]}],["$","section",null,{"className":"terms-section","children":[["$","h2",null,{"children":"8. Cancellation & Access"}],["$","p",null,{"children":"Cancelling your subscription does not automatically trigger a refund. Upon cancellation, access to the platform continues until the end of the current billing period. To request a refund in addition to cancellation, please follow the process outlined in Section 7."}]]}],["$","section",null,{"className":"terms-section","children":[["$","h2",null,{"children":"9. Consumer Rights"}],["$","p",null,{"children":"Nothing in this policy limits your statutory rights under applicable consumer protection or distance selling legislation. EU/EEA customers exercising the 14-day cooling-off right under the Consumer Rights Directive should note that, by commencing use of a digital service, you may waive this right. We will inform you clearly before purchase where this applies."}]]}],["$","section",null,{"className":"terms-section","children":[["$","h2",null,{"children":"10. Changes to This Policy"}],["$","p",null,{"children":"NovraLab reserves the right to update this Refund Policy at any time. Material changes will be communicated by email or a prominent notice on our website at least 14 days before taking effect."}]]}],["$","section",null,{"className":"terms-section","children":[["$","h2",null,{"children":"11. Contact"}],["$","address",null,{"className":"terms-contact","children":[["$","strong",null,{"children":"NovraLab — Billing & Refunds"}],["$","br",null,{}],"Email: ",["$","a",null,{"href":"mailto:billing@novralab.com","children":"billing@novralab.com"}],["$","br",null,{}],"General enquiries: ",["$","a",null,{"href":"mailto:legal@novralab.com","children":"legal@novralab.com"}],["$","br",null,{}],"Website: ",["$","a",null,{"href":"https://novralab.com","children":"novralab.com"